#!/bin/sh
# Starts seesongs inside the AppImage, after linuxdeploy's own AppRun has run the GTK plugin's
# setup. It runs from usr/ because the bundled WebKit finds its helper processes by a path that
# appimage.sh made relative to there.
APPDIR=$(dirname "$(readlink -f "$0")")
export APPDIR
# The GTK plugin's hook forces X11. Wayland works with the system's own Wayland libraries, which
# appimage.sh leaves out, so GTK is left to pick, falling back to X11 without Wayland.
unset GDK_BACKEND
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
cd "$APPDIR/usr" || exit 1
exec "$APPDIR/usr/bin/seesongs" "$@"
